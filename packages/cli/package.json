{
  "name": "@zeropg/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "zeropg": "./src/zeropg.ts"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "description": "The zeropg CLI. `zeropg migrate dev` / `zeropg migrate deploy`: a Prisma-migration workflow for zeropg/PGlite that needs no external Postgres and avoids the native migrate engine (which can't drive single-session PGlite).",
  "license": "MIT",
  "dependencies": {
    "@zeropg/client": "*"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5.2",
    "@electric-sql/pglite-socket": ">=0.2.2",
    "@zeropg/blobstore": "*",
    "@zeropg/objectstore-fs": "*"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": { "optional": true },
    "@electric-sql/pglite-socket": { "optional": true },
    "@zeropg/blobstore": { "optional": true },
    "@zeropg/objectstore-fs": { "optional": true }
  },
  "engines": {
    "node": ">=22"
  }
}
