{
  "name": "@zeropg/server",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wire-frontend": {
      "types": "./dist/wire-frontend.d.ts",
      "import": "./dist/wire-frontend.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "tsx test/startup-packet.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zeropg/blobstore": "^0.1.0",
    "@zeropg/objectstore-fs": "^0.1.0"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "@electric-sql/pglite-socket": "*"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@electric-sql/pglite-socket": {
      "optional": true
    }
  },
  "description": "Early experiment in the cheapest possible scale-to-zero Postgres. Standalone dedicated-Postgres server for zeropg: one scale-to-zero container holding the lease + PGlite + ObjectStoreFS, exposing the real Postgres wire protocol (pglite-socket) on a local port, a default-on PostgREST auto-REST API, and an HTTP control face (/wake, /ready, POST /sql) a remote app connects to.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reisepass/zeropg.git",
    "directory": "packages/server"
  },
  "keywords": [
    "postgres",
    "pglite",
    "postgrest",
    "wire-protocol",
    "scale-to-zero",
    "serverless"
  ],
  "engines": {
    "node": ">=22"
  }
}
